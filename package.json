{
  "name": "@uni-helper/uni-use",
  "type": "module",
  "version": "0.19.17",
  "packageManager": "pnpm@12.18.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26",
      "onFail": "warn"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "warn"
    }
  },
  "description": "uni-app (vue3) 组合式工具集",
  "author": {
    "name": "ModyQyW",
    "email": "wurui.dev@gmail.com",
    "url": "https://modyqyw.top"
  },
  "license": "MIT",
  "homepage": "https://github.com/uni-helper/uni-use#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uni-helper/uni-use.git"
  },
  "bugs": {
    "url": "https://github.com/uni-helper/uni-use/issues"
  },
  "keywords": [
    "uni-app",
    "uniapp",
    "uni",
    "use",
    "composition",
    "composable"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "dev": "tsdown --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepublishOnly": "pnpm run build",
    "release": "bumpp",
    "test": "vitest",
    "docs:dev": "pnpm -C docs run dev",
    "docs:build": "pnpm -C docs run build",
    "docs:preview": "pnpm -C docs run preview",
    "play:mp-weixin": "npm -C playground run dev:mp-weixin",
    "build:mp-weixin": "npm -C playground run build:mp-weixin",
    "play:h5": "npm -C playground run dev:h5",
    "build:h5": "npm -C playground run build:h5"
  },
  "peerDependencies": {
    "typescript": "^5.0.0 || ^6.0.0",
    "vue": "^3.2.47"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "dependencies": {
    "@dcloudio/types": "catalog:",
    "@dcloudio/uni-app": "catalog:"
  },
  "devDependencies": {
    "@dcloudio/uni-app": "catalog:",
    "@dcloudio/uni-cli-shared": "catalog:",
    "@dcloudio/uni-h5": "catalog:",
    "@dcloudio/uni-h5-vue": "catalog:",
    "@dcloudio/vite-plugin-uni": "catalog:",
    "@tsconfig/node26": "catalog:",
    "@types/node": "catalog:",
    "@uni-helper/eslint-config": "catalog:",
    "bumpp": "catalog:",
    "eslint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitepress": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:"
  }
}
